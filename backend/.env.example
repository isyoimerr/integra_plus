DATABASE_URL="postgresql://postgres:password@db.[project-ref].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:password@db.[project-ref].supabase.co:5432/postgres"
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

JWT_SECRET=replace_with_a_secure_secret_for_local_dev

# SMTP para OTP y recuperación por correo
# Opción 1 (recomendada): host SMTP explícito
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password_de_gmail

# Opción 2 (compatibilidad): alias usados en SETUP antiguo
SMTP_EMAIL=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_de_gmail
